# LF везде — shell-скрипты исполняются в Linux (Docker/CI), CRLF их ломает.
* text=auto
*.sh text eol=lf
*.js text eol=lf
*.html text eol=lf
*.conf text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
Dockerfile text eol=lf
*.md text eol=lf
*.patch text eol=lf
*.lock text eol=lf
*.pack binary
*.wasm binary
sources/*.tar.* binary
sources/*.tgz binary
.htaccess text eol=lf
